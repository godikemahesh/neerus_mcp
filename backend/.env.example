# Copy this file to .env for local development. On Render, set these as
# regular environment variables in the service's dashboard instead.

# Supabase project -> Settings -> Database -> Connection string -> URI
# (use the "Session pooler" connection if your network blocks direct IPv6).
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase project -> Settings -> API Keys -> "Secret keys" section
# (starts with sb_secret_...; this replaces the legacy service_role key)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY
SUPABASE_STORAGE_BUCKET=raw-uploads

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# This becomes part of the Claude connector URL: https://<host>/mcp/<this>/
MCP_PATH_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE

# Shared login for the admin upload/delete UI.
ADMIN_PASSWORD=choose-a-strong-password

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_VALUE

# Comma-separated list of frontend origins allowed to call the API,
# e.g. https://neerus-mcp-admin.vercel.app
CORS_ORIGINS=http://localhost:5173

# Set to false only when testing locally over plain http://
COOKIE_SECURE=true

MAX_ROWS=200
MAX_FILE_MB=30
MAX_QUERY_LENGTH=10000
